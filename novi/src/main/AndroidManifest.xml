<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_novi_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Novi">
        <activity
            android:name=".NoviActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider
            android:name=".PhotoZipProvider"
            android:authorities="com.ahbe.novi.photozips"
            android:exported="false"
            android:grantUriPermissions="true"/>
        <provider
            android:name=".NoviAudioProvider"
            android:authorities="com.ahbe.novi.audiofiles"
            android:exported="false"
            android:grantUriPermissions="true"/>
    </application>
</manifest>
